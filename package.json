{
  "name": "smile-agent",
  "version": "1.0.0",
  "description": "SmileAI development agent",
  "main": "dist/index.js",
  "bin": {
    "smile-agent": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "agent": "tsx src/cli/index.ts",
    "agent:preview": "tsx src/cli/index.ts --mode preview",
    "agent:dry-run": "tsx src/cli/index.ts --mode dry-run",
    "agent:apply": "tsx src/cli/index.ts --mode apply",
    "agent:ci": "tsx src/cli/index.ts --ci --diff-aware --mode preview --output .agent-cache/last-result.json",
    "agent:ci:verbose": "tsx src/cli/index.ts --ci --diff-aware --mode preview --verbose --output .agent-cache/last-result.json"
  },
  "keywords": [
    "agent",
    "cli",
    "smileai",
    "developer-tools"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^14.0.0",
    "dotenv": "^17.0.0",
    "fast-glob": "^3.3.3",
    "openai": "^5.12.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  }
}
