{
  "name": "zone-ai-agent",
  "version": "0.7.0",
  "description": "Zone � AI Code Agent: deterministic, explainable, safe",
  "main": "dist/index.js",
  "bin": {
    "zone": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "zone": "tsx src/cli/index.ts",
    "serve": "tsx src/cli/index.ts serve",
    "zone:preview": "tsx src/cli/index.ts --mode preview",
    "zone:dry-run": "tsx src/cli/index.ts --mode dry-run",
    "zone:apply": "tsx src/cli/index.ts --mode apply",
    "zone:ci": "tsx src/cli/index.ts --ci --diff-aware --mode preview --output .agent-cache/last-result.json",
    "zone:ci:verbose": "tsx src/cli/index.ts --ci --diff-aware --mode preview --verbose --output .agent-cache/last-result.json"
  },
  "keywords": [
    "agent",
    "cli",
    "zone",
    "developer-tools"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^2.2.2",
    "commander": "^14.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "openai": "^5.12.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  }
}
