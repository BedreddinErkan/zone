{
  "name": "zone-api",
  "version": "0.0.1",
  "private": true,
  "description": "Zone backend API and CLI",
  "main": "./dist/server.js",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/ui','dist/ui',{recursive:true,force:true})\"",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "serve": "node dist/cli/index.js serve",
    "start": "node dist/cli/index.js serve",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@supabase/supabase-js": "^2.57.4",
    "body-parser": "^1.20.3",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fast-glob": "^3.3.3",
    "openai": "^5.23.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
