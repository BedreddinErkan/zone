# === LLM Provider Keys (at least one required) ===
# Both can also be set via Settings → API Keys after first launch.

# Anthropic Claude — Sonnet 4.6 default, recommended for cost/quality balance.
ANTHROPIC_API_KEY=

# OpenAI — gpt-5.4 / gpt-5.4-mini.
OPENAI_API_KEY=


# === Optional: Visual verification ===

# Dev server URL the agent targets when calling verify_visual.
# Overrides Settings → Visual. Defaults to http://localhost:3000.
ZONE_DEV_SERVER_URL=http://localhost:3000


# === Optional: Cache Tuning (Anthropic only) ===

# Anthropic prompt caching with message-tail breakpoint is enabled by default
# (~50%+ input savings on multi-iter runs, hit ratio 90–96% by iter 3+).
# Set to 0 to opt out (e.g., cost-comparison testing).
ZONE_ENABLE_MESSAGE_CACHE=1


# === Optional: Diagnostics ===

# Verbose internal logs (request flow, cache hits, tool calls, performance traces).
# Useful when filing a bug report or investigating agent behavior locally.
ZONE_VERBOSE_LOGS=0


# === Optional: Server ===

# Port for the local serve command (default 3000).
PORT=3000
